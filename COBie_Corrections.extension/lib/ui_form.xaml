<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="COBie Corrections"
    Width="900" Height="680"
    MinWidth="720" MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#F5F5F5"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <!-- ── Group header style ── -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- ── Column header style ── -->
        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- ── Alternating row background ── -->
        <Style x:Key="OddRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
        <Style x:Key="EvenRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFEFEF"/>
        </Style>

        <!-- ── Primary action button ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A3A5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24507A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2840"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary (outline) button ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#1A3A5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8EFF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar -->
            <RowDefinition Height="*"/>      <!-- issue groups -->
            <RowDefinition Height="Auto"/>   <!-- bottom toolbar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
             Title
        ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="COBie Corrections — Compliance Review"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#1A3A5C"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="IssueCountLabel"
                       Text=""
                       FontSize="12" Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════
             Scrollable issue list grouped by COBie category
        ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="GroupsPanel">

                <!-- ─── Each group is injected by script.py as a child Border ─── -->
                <!-- Template for a single group (rendered programmatically):

                <Border Margin="0,0,0,12" Background="White"
                        BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <!- - Group header row - ->
                        <Border Background="#E2EAF3" CornerRadius="4,4,0,0" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Type"
                                           Style="{StaticResource GroupHeaderStyle}"/>
                                <Button Grid.Column="1" Content="Select All"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0"
                                        Click="OnSelectAll"/>
                                <Button Grid.Column="2" Content="Deselect All"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnDeselectAll"/>
                            </Grid>
                        </Border>

                        <!- - Column headers - ->
                        <Grid Margin="10,6,10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text=""  Style="{StaticResource ColHeaderStyle}"/>
                            <TextBlock Grid.Column="1" Text="Was"          Style="{StaticResource ColHeaderStyle}"/>
                            <TextBlock Grid.Column="2" Text="Corrected To" Style="{StaticResource ColHeaderStyle}"/>
                            <TextBlock Grid.Column="3" Text="Rule"         Style="{StaticResource ColHeaderStyle}"/>
                        </Grid>

                        <!- - ItemsControl bound to group's issues - ->
                        <ItemsControl x:Name="IssueList_Type" .../>
                    </StackPanel>
                </Border>
                -->

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════
             Bottom toolbar
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#E9EEF3"
                BorderBrush="#C8C8C8" BorderThickness="0,1,0,0"
                Padding="0,10,0,0"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- selected count feedback -->
                <TextBlock x:Name="SelectionFeedback"
                           Grid.Column="0"
                           Text="0 corrections selected"
                           Foreground="#555"
                           VerticalAlignment="Center"/>

                <!-- Cancel -->
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="OnCancel"/>

                <!-- Apply Corrections -->
                <Button x:Name="ApplyButton"
                        Grid.Column="2"
                        Content="Apply Corrections"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="OnApply"/>
            </Grid>
        </Border>
    </Grid>
</Window>
